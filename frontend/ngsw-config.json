{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "aplicacion",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "recursos",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|png|jpg|jpeg|webp|woff|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "consultas-de-la-api",
      "urls": [
        "https://container-tracking-api.onrender.com/carros**",
        "https://container-tracking-api.onrender.com/cargas**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 30,
        "maxAge": "12h",
        "timeout": "8s"
      }
    }
  ]
}
