# Copia este archivo como `.env` (en esta misma carpeta) y completa los valores.
# El archivo `.env` NUNCA se sube a GitHub; este `.env.example` sí, sin valores reales.
# La tarea "API (backend)" de VS Code lo carga sola.

# Clave para firmar los tokens de inicio de sesión. Usa un texto largo y aleatorio:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Opcional. Por defecto se usa SQLite local (container_tracking.db).
# En producción: la cadena de conexión de Supabase (PostgreSQL).
# DATABASE_URL=

# Opcional. Dominios del frontend permitidos, separados por comas.
# Por defecto: http://localhost:4200 y http://127.0.0.1:4200
# CORS_ORIGINS=
