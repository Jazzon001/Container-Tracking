# Qué se mide con `pytest --cov`: todo el código de la carpeta backend, menos las pruebas
# y los entornos virtuales.
[run]
source = .
omit =
    test/*
    .venv/*
    venv/*

# El arranque `if __name__ == "__main__":` de los scripts solo llama a main(), que ya se prueba.
[report]
exclude_also =
    if __name__ == .__main__.:
